{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-evidence-agent-free",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./ui", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "research-evidence-agent", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
